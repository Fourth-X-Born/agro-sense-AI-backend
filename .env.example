# Copy this file to .env and fill in real values.
# .env is gitignored — never commit your actual .env file.

# Database
DB_URL=jdbc:mysql://localhost:3306/agrosense_db
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password

# OpenWeatherMap (https://openweathermap.org/api)
WEATHER_API_KEY=your_openweathermap_api_key

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT signing secret — generate your own, e.g.: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_base64_string
# Token lifetime in milliseconds (default 24h if omitted)
JWT_EXPIRATION_MS=86400000
